# ==============================================================================
# Legal Metrology Compliance Platform - Backend Environment Variables
# ==============================================================================

# Application Configuration
PROJECT_NAME="Legal Metrology Compliance Platform"
API_V1_STR="/api"
HOST="127.0.0.1"
PORT=8000
LOG_LEVEL="INFO"

# Security & JWT Authentication
# In production, replace SECRET_KEY with a strong 32+ character random secret
SECRET_KEY="supersecretkey-for-development-only-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# AI & OCR Engine Configuration
OCR_USE_GPU=false
OCR_LANGUAGES="en"

# Firebase Admin SDK (Optional - Leave blank to use built-in local authentication)
FIREBASE_CREDENTIALS_PATH=""
