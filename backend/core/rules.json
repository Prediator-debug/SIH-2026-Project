{
  "rules": [
    {
      "rule_id": "LM-001",
      "title": "Manufacturer/Packer/Importer Name & Address",
      "source": "Rule 6(1)(a), Rule 10 - LM(PC) Rules 2011",
      "chapter": "II - Retail Packages",
      "applies_to": ["retail_package"],
      "exemptions": {
        "condition": "net_quantity <= 10 (g/ml)",
        "note": "Rule 26(a): fully exempt below 10g/10ml; between 10-20g/ml only MRP and net quantity required, this rule can be relaxed"
      },
      "field_required": "manufacturer_details",
      "condition": {
        "type": "field_present_non_empty",
        "field": "manufacturer_details",
        "sub_fields_any_one_of": ["manufacturer_name_address", "packer_name_address", "importer_name_address"],
        "min_confidence": 0.85
      },
      "on_missing": "FAIL",
      "on_low_confidence": "REVIEW_REQUIRED",
      "version": "2011-base",
      "effective_from": "2011-04-01",
      "effective_to": null,
      "notes": "If only brand name present without 'manufactured by'/'packed by', law presumes it is manufacturer (Explanation I) - flag as REVIEW if ambiguous qualifier missing."
    },
    {
      "rule_id": "LM-002",
      "title": "Common/Generic Name of Commodity",
      "source": "Rule 6(1)(b)",
      "chapter": "II",
      "applies_to": ["retail_package"],
      "exemptions": {},
      "field_required": "commodity_name",
      "condition": {
        "type": "field_present_non_empty",
        "field": "commodity_name",
        "min_confidence": 0.85
      },
      "on_missing": "FAIL",
      "on_low_confidence": "REVIEW_REQUIRED",
      "version": "2011-base",
      "effective_from": "2011-04-01",
      "effective_to": null,
      "notes": "For multi-product packages, name/number/quantity of each product must be mentioned."
    },
    {
      "rule_id": "LM-003",
      "title": "Net Quantity Declaration",
      "source": "Rule 6(1)(c), Rule 11, Rule 12, Rule 13",
      "chapter": "II",
      "applies_to": ["retail_package"],
      "exemptions": {
        "condition": "net_quantity <= 10 (g/ml)",
        "note": "Rule 26(a) exemption; but Rule 26(a) proviso requires declaration for 10-20g/ml range"
      },
      "field_required": "net_quantity",
      "condition": {
        "type": "field_present_and_valid_unit",
        "field": "net_quantity",
        "allowed_units": ["g", "kg", "ml", "l", "cm", "m", "sq.cm", "sq.m", "number", "N", "U"],
        "forbidden_words": ["minimum", "not less than", "average", "about", "approximately"],
        "min_confidence": 0.85
      },
      "on_missing": "FAIL",
      "on_low_confidence": "REVIEW_REQUIRED",
      "version": "2011-base",
      "effective_from": "2011-04-01",
      "effective_to": null,
      "notes": "Rule 12(6): quantity wording must not be exaggerated/misleading - forbidden_words check is a text-pattern flag, not exhaustive."
    },
    {
      "rule_id": "LM-004",
      "title": "MRP / Retail Sale Price Declaration",
      "source": "Rule 6(1)(e), Rule 2(m), Rule 18(2)",
      "chapter": "II",
      "applies_to": ["retail_package"],
      "exemptions": {
        "excluded_items": ["bidi", "domestic_LPG_cylinder_under_APM_price"],
        "note": "Rule 6(1)(g) proviso (C); alcoholic beverages governed by State Excise Law unless silent, then these rules apply"
      },
      "field_required": "mrp",
      "condition": {
        "type": "field_present_and_valid_format",
        "field": "mrp",
        "format_regex": "(MRP|Maximum Retail Price|Max\\.?\\s*retail price)\\s*(Rs\\.?|₹)\\s?\\d+(\\.\\d{2})?.*(incl(usive)?\\.?\\s*of all taxes)",
        "min_confidence": 0.85
      },
      "on_missing": "FAIL",
      "on_low_confidence": "REVIEW_REQUIRED",
      "version": "2011-base",
      "effective_from": "2011-04-01",
      "effective_to": null,
      "notes": "Rule 2(m): must state 'inclusive of all taxes'; rounding rule <50 paise down, 50-95 paise to 50 paise. Rule 18(2): sale price must not exceed declared MRP - this is a separate cross-check against transaction data if available."
    },
    {
      "rule_id": "LM-005",
      "title": "Month & Year of Manufacture/Pre-pack/Import",
      "source": "Rule 6(1)(d)",
      "chapter": "II",
      "applies_to": ["retail_package"],
      "exemptions": {
        "excluded_items": ["bidis", "incense_sticks", "domestic_LPG_cylinder_14.2kg_or_5kg_PSU"],
        "excluded_categories": ["food_articles (PFA Act applies instead)", "seeds (Seeds Act applies instead)", "cosmetics (Drugs & Cosmetics Rules apply instead)"]
      },
      "field_required": "manufacture_month_year",
      "condition": {
        "type": "field_present_and_valid_format",
        "field": "manufacture_month_year",
        "format_regex": "(0[1-9]|1[0-2])[\\/\\-\\.]?\\d{4}|[A-Za-z]{3,9}\\s\\d{4}",
        "min_confidence": 0.8
      },
      "on_missing": "FAIL",
      "on_low_confidence": "REVIEW_REQUIRED",
      "version": "2011-base",
      "effective_from": "2011-04-01",
      "effective_to": null,
      "notes": "Category-based exemption logic needed - engine must know product category before applying this rule."
    },
    {
      "rule_id": "LM-006",
      "title": "Consumer Care / Complaint Contact Details",
      "source": "Rule 6(2)",
      "chapter": "II",
      "applies_to": ["retail_package"],
      "exemptions": {},
      "field_required": "consumer_care_details",
      "condition": {
        "type": "field_present_non_empty",
        "field": "consumer_care_details",
        "sub_fields_required": ["name_or_office", "address", "phone_or_email"],
        "min_confidence": 0.8
      },
      "on_missing": "FAIL",
      "on_low_confidence": "REVIEW_REQUIRED",
      "version": "2011-base",
      "effective_from": "2011-04-01",
      "effective_to": null,
      "notes": "Rule text says 'telephone number, e-mail address, if available' - email/phone may be optional depending on interpretation; flag REVIEW rather than FAIL if only one channel present."
    },
    {
      "rule_id": "LM-007",
      "title": "Numeral Height on Principal Display Panel",
      "source": "Rule 7(2)(3), Table I & Table II",
      "chapter": "II",
      "applies_to": ["retail_package"],
      "exemptions": {
        "condition": "package_capacity <= 5 cubic cm",
        "note": "Rule 7(4): not applicable if another law already mandates the info"
      },
      "field_required": "numeral_height_mm",
      "condition": {
        "type": "lookup_table_by_quantity_band",
        "field": "numeral_height_mm",
        "table": {
          "weight_volume": [
            {"band": "up to 200g/ml", "min_mm_normal": 1, "min_mm_molded": 2},
            {"band": "200-500g/ml", "min_mm_normal": 2, "min_mm_molded": 4},
            {"band": "above 500g/ml", "min_mm_normal": 4, "min_mm_molded": 6}
          ],
          "length_area_number": [
            {"band": "up to 100 sq.cm", "min_mm_normal": 1, "min_mm_molded": 2},
            {"band": "100-500 sq.cm", "min_mm_normal": 2, "min_mm_molded": 4},
            {"band": "500-2500 sq.cm", "min_mm_normal": 4, "min_mm_molded": 6},
            {"band": "above 2500 sq.cm", "min_mm_normal": 6, "min_mm_molded": 6}
          ]
        },
        "min_confidence": 0.7
      },
      "on_missing": "REVIEW_REQUIRED",
      "on_low_confidence": "REVIEW_REQUIRED",
      "version": "2011-base",
      "effective_from": "2011-04-01",
      "effective_to": null,
      "notes": "Needs pixel-to-mm calibration from image - low reliability from OCR alone; default to REVIEW_REQUIRED rather than FAIL unless measurement pipeline is calibrated."
    },
    {
      "rule_id": "LM-008",
      "title": "Language of Declaration",
      "source": "Rule 9(4)",
      "chapter": "II",
      "applies_to": ["retail_package"],
      "exemptions": {},
      "field_required": "declaration_language",
      "condition": {
        "type": "value_in_set",
        "field": "declaration_language",
        "allowed_values": ["hindi_devanagari", "english", "hindi_and_english", "hindi_or_english_plus_other"],
        "min_confidence": 0.8
      },
      "on_missing": "REVIEW_REQUIRED",
      "on_low_confidence": "REVIEW_REQUIRED",
      "version": "2011-base",
      "effective_from": "2011-04-01",
      "effective_to": null,
      "notes": "Other languages allowed IN ADDITION to Hindi/English, not instead of."
    },
    {
      "rule_id": "LM-009",
      "title": "Non-Standard Pack Size Declaration",
      "source": "Rule 5 (proviso, withdrawn wef 01.07.2012 vide GSR 748(E))",
      "chapter": "II",
      "applies_to": ["retail_package_of_scheduled_commodity"],
      "exemptions": {},
      "field_required": "non_standard_size_declaration",
      "condition": {
        "type": "conditional_field_presence",
        "note": "This proviso was withdrawn effective 01.07.2012 - retained here for historical/audit reference only, NOT active."
      },
      "on_missing": "N/A",
      "on_low_confidence": "N/A",
      "version": "2011-base",
      "effective_from": "2011-04-01",
      "effective_to": "2012-06-30",
      "notes": "INACTIVE RULE - kept for version history. Engine must exclude this from active rule set for any as_of_date after 2012-06-30."
    },
    {
      "rule_id": "LM-010",
      "title": "No Individual Stickers to Alter Declarations",
      "source": "Rule 6(3)(4)",
      "chapter": "II",
      "applies_to": ["retail_package"],
      "exemptions": {
        "condition": "sticker only reduces MRP and does not cover original MRP printed by manufacturer/packer"
      },
      "field_required": "sticker_detected",
      "condition": {
        "type": "image_based_flag",
        "field": "sticker_detected",
        "logic": "if sticker_detected AND sticker_covers_original_declaration -> FAIL; if sticker_detected AND sticker_is_mrp_reduction_only -> PASS; else REVIEW_REQUIRED",
        "min_confidence": 0.7
      },
      "on_missing": "PASS",
      "on_low_confidence": "REVIEW_REQUIRED",
      "version": "2011-base",
      "effective_from": "2011-04-01",
      "effective_to": null,
      "notes": "Needs visual sticker-detection model, not just OCR - flag as REVIEW_REQUIRED by default until that model exists."
    }
  ],
